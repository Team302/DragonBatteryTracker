# Postgres credentials — used by both db and api services
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=frc_batteries

# This gets overridden in docker-compose.yml to use the db service hostname.
# For local development outside Docker, point this at localhost instead.
#DATABASE_URL=postgresql+asyncpg://frc:frcpassword@localhost:5432/frc_batteries

# App settings
SECRET_KEY=change-me-to-something-random
TEAM_NUMBER=1234
PUBLIC_HOST=https://your-hostname.example.com
ENVIRONMENT=production  # Set to 'development' to enable auto-creation of tables on startup

# IR thresholds (Ω)
IR_WARN_THRESHOLD=0.022
IR_RETIRE_THRESHOLD=0.030
BASIC_AUTH_PASSWORD=CHANGE_THIS_PASSWORD
